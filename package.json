{
  "name": "gutech-lms-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GUTECH LMS Student/Faculty Portal - React + Node.js (Express) + Supabase, deployed on Vercel",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20"
  }
}
